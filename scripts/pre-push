#!/usr/bin/env bash
# pre-push hook — run the generic leak gate on exactly what is being pushed.
#
# Install (from the repository root):
#   ln -sf ../../scripts/pre-push .git/hooks/pre-push
# or, if symlinks are not desired:
#   cp scripts/pre-push .git/hooks/pre-push
#   chmod +x .git/hooks/pre-push
#
# Git feeds one line per pushed ref on stdin:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# For each ref we scan only the pushed range:
#   * new branch (remote_sha is all zeros): <root-of-local_sha>..<local_sha>
#   * otherwise:                            <remote_sha>..<local_sha>
# We then run one working-tree scan to cover unstaged/staged local state.
#
# A push can always skip hooks with `git push --no-verify`, so CI runs the
# same generic gate on every push and pull request
# (see .github/workflows/leak-check.yml).

set -uo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "pre-push: not inside a git repository" >&2
    exit 1
}
cd "$repo_root" || exit 1

ZERO="0000000000000000000000000000000000000000"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # Ignore ref deletions (nothing is being introduced).
    [ "$local_sha" = "$ZERO" ] && continue

    if [ "$remote_sha" = "$ZERO" ]; then
        base="$(git rev-list --max-parents=0 "$local_sha" | tail -n1)"
        range="${base}..${local_sha}"
    else
        range="${remote_sha}..${local_sha}"
    fi

    echo "pre-push: leak scan for ${local_ref} (${range})"
    if ! bash scripts/check_leaks.sh "$range"; then
        echo "pre-push: leak check FAILED for ${range}" >&2
        status=1
    fi
done

echo "pre-push: leak scan for working tree"
if ! bash scripts/check_leaks.sh; then
    echo "pre-push: working-tree leak check FAILED" >&2
    status=1
fi

if [ "$status" -ne 0 ]; then
    echo "pre-push: aborting push due to leak findings" >&2
    exit 1
fi

exit 0
